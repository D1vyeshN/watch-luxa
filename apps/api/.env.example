# Environment variables
# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/luxe-timepieces

# Auth
JWT_ACCESS_SECRET=change-me-to-a-32-char-minimum-secret-key-here
JWT_REFRESH_SECRET=change-me-to-another-32-char-minimum-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Super Admin (Optional - for system admin without DB storage)
# Set these to enable a super admin that bypasses database authentication
# SUPER_ADMIN_EMAIL=superadmin@luxe.com
# SUPER_ADMIN_PASSWORD=YourSecurePassword123!

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Supabase Storage
# Requires a PUBLIC bucket named `luxe-timepieces` (see src/config/supabase.ts)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...   (or legacy service_role JWT: eyJhbGci...)

# Supabase S3-compatible storage (optional — not used by the API today;
# uploads go through supabase-js with SUPABASE_SERVICE_KEY)
# SUPABASE_S3_ENDPOINT=https://your-project-id.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ap-south-1
# SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
# SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key

# ─── Stripe ───
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Razorpay ───
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...