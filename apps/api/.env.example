# Environment variables
# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/luxe-timepieces

# Auth
JWT_ACCESS_SECRET=change-me-to-a-32-char-minimum-secret-key-here
JWT_REFRESH_SECRET=change-me-to-another-32-char-minimum-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info