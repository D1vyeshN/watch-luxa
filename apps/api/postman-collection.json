{
  "info": {
    "name": "Watch Luxa API",
    "description": "Complete API collection for Watch Luxa e-commerce platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "brandId",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "health"]
            },
            "description": "Check server health and uptime"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "register"]
            },
            "description": "Register a new user account"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "login"]
            },
            "description": "Login and receive access/refresh tokens"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "pm.collectionVariables.set('userId', jsonData.data.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "refresh"]
            },
            "description": "Refresh access token using refresh token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "logout"]
            },
            "description": "Logout and invalidate refresh token"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "auth", "me"]
            },
            "description": "Get current authenticated user profile"
          }
        }
      ]
    },
    {
      "name": "Admin - Brands",
      "item": [
        {
          "name": "List Brands",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/admin/brands?page=1&limit=10&sortBy=name&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "admin", "brands"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "name"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Optional: search by name"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Optional: active or archived"
                },
                {
                  "key": "isSystem",
                  "value": "",
                  "description": "Optional: true or false"
                }
              ]
            },
            "description": "List all brands with pagination, filters, and search"
          }
        },
        {
          "name": "Create Brand",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rolex\",\n  \"slug\": \"rolex\",\n  \"description\": \"Swiss luxury watch manufacturer\",\n  \"logo\": \"https://example.com/logo.png\",\n  \"website\": \"https://www.rolex.com\",\n  \"country\": \"Switzerland\",\n  \"foundedYear\": 1905,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/admin/brands",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "admin", "brands"]
            },
            "description": "Create a new brand"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('brandId', jsonData.data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Brand by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/admin/brands/:id",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "admin", "brands", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{brandId}}"
                }
              ]
            },
            "description": "Get a specific brand by ID"
          }
        },
        {
          "name": "Update Brand",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rolex Updated\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/admin/brands/:id",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "admin", "brands", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{brandId}}"
                }
              ]
            },
            "description": "Update a brand (system brands cannot be renamed)"
          }
        },
        {
          "name": "Archive Brand",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/admin/brands/:id",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "admin", "brands", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{brandId}}"
                }
              ]
            },
            "description": "Archive a brand (system brands cannot be archived)"
          }
        },
        {
          "name": "Restore Brand",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/admin/brands/:id/restore",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPrefix}}", "admin", "brands", ":id", "restore"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{brandId}}"
                }
              ]
            },
            "description": "Restore an archived brand"
          }
        }
      ]
    },
